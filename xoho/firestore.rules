rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: public read of published items, write requires auth
    match /products/{productId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create (checkout), only auth can read/update
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['productId','buyerEmail','buyerPhone','amount','status'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 50;
      allow read, update: if request.auth != null
                          || resource.id == orderId; // allow owner to read their order by ID
      allow delete: if request.auth != null;
    }

    // Settings: admin only
    match /settings/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
