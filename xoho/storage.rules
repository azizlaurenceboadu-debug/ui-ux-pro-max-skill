rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product files: only authenticated users (admin) can upload/delete
    match /products/{fileName} {
      allow read:  if true;   // Public read (download link is single-use via signed URL in production)
      allow write: if request.auth != null;
    }

    // Preview images: public read, admin write
    match /previews/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
